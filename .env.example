# Copy to .env and set local credentials. Never commit .env.
API_HOST=127.0.0.1
API_PORT=5505
NODE_ENV=development
LOG_LEVEL=info
RELEASE_VERSION=1.0.0
DATABASE_URL=postgresql://tip_app:CHANGE_ME@127.0.0.1:5432/tip_tasks
ENABLE_DEBUG_RESET=true

# Variant 8: request body limit in bytes. Larger JSON requests return HTTP 413.
JSON_BODY_LIMIT_BYTES=16384

# Used by Docker Compose only.
POSTGRES_PASSWORD=CHANGE_ME
