# Copy this file to .env and replace the password locally.
# Never commit .env or paste the real DATABASE_URL into screenshots.
API_HOST=127.0.0.1
API_PORT=5505
NODE_ENV=development
LOG_LEVEL=info
RELEASE_VERSION=1.0.0
DATABASE_URL=postgresql://tip_app:CHANGE_ME@127.0.0.1:5432/tip_tasks
ENABLE_DEBUG_RESET=true

# Variant 8: maximum raw JSON request body size in bytes.
# Requests larger than this value receive HTTP 413 PAYLOAD_TOO_LARGE.
JSON_BODY_LIMIT_BYTES=16384
